// Render with: neato -n2 -Tsvg assets/wiring.dot -o assets/wiring.svg
digraph wiring {
  graph [layout=neato, splines=line, overlap=true, bgcolor="white", pad="0.15"];
  node [shape=point, width=0, height=0, label="", pin=true];
  edge [dir=none, color="#20242a", penwidth=1.5, headclip=true, tailclip=true];
  sb [pos="110,560!", shape=circle, width=0.07, height=0.07];
  five [pos="330,560!", shape=circle, width=0.07, height=0.07];
  sb -> five;
  sb_label [pos="60,560!", shape=plaintext, fontname="sans-serif", fontsize=12, fontcolor="#20242a", label="ATX\n+5VSB"];
  five_label [pos="375,560!", shape=plaintext, fontname="sans-serif", fontsize=12, fontcolor="#20242a", label="ESP 5V"];

  // Power button
  p_io [pos="95,410!", shape=circle, width=0.07, height=0.07];
  p_res [pos="170,410!", shape=box, width=0.75, height=0.3, fontname="sans-serif", fontsize=12, label="2.2 kΩ"];
  p_b [pos="240,410!", width=0.055, height=0.055];
  p_bar [pos="295,410!"];
  p_bar_top [pos="295,425!"];
  p_bar_bottom [pos="295,395!"];
  p_c_base [pos="295,421!"];
  p_e_base [pos="295,399!"];
  p_c [pos="325,440!"];
  p_e [pos="325,380!"];
  p_c_wire [pos="325,470!", width=0.055, height=0.055];
  p_signal [pos="500,470!", shape=circle, width=0.07, height=0.07];
  p_switch_top [pos="500,430!", shape=circle, width=0.07, height=0.07];
  p_switch_blade [pos="485,400!"];
  p_switch_bottom [pos="500,395!", shape=circle, width=0.07, height=0.07];
  p_header_gnd [pos="500,335!", shape=circle, width=0.07, height=0.07];
  p_gnd [pos="325,335!", width=0.055, height=0.055];
  p_pull_gnd [pos="240,335!"];
  p_pull [pos="240,365!", shape=box, width=0.62, height=0.32, fontname="sans-serif", fontsize=12, label="10 kΩ"];
  p_stem [pos="325,325!"];
  p_g1l [pos="311,325!"];
  p_g1r [pos="339,325!"];
  p_g2l [pos="316,319!"];
  p_g2r [pos="334,319!"];
  p_g3l [pos="321,313!"];
  p_g3r [pos="329,313!"];
  p_transistor [pos="310,410!", shape=circle, width=0.85, height=0.85, color="#20242a"];
  p_io -> p_res;
  p_res -> p_b;
  p_b -> p_bar;
  p_bar_top -> p_bar_bottom [penwidth=3];
  p_c_base -> p_c;
  p_c -> p_c_wire;
  p_c_wire -> p_signal;
  p_e -> p_gnd;
  p_b -> p_pull;
  p_pull -> p_pull_gnd;
  p_pull_gnd -> p_gnd;
  p_gnd -> p_header_gnd;
  p_signal -> p_switch_top;
  p_switch_top -> p_switch_blade;
  p_switch_bottom -> p_header_gnd;
  p_gnd -> p_stem;
  p_g1l -> p_g1r;
  p_g2l -> p_g2r;
  p_g3l -> p_g3r;
  p_e_base -> p_e [dir=forward, arrowhead=normal, arrowsize=0.65];
  p_io_label [pos="45,410!", shape=plaintext, fontname="sans-serif", fontsize=12, fontcolor="#20242a", label="ESP\nGPIO3"];
  p_signal_label [pos="445,493!", shape=plaintext, fontname="sans-serif", fontsize=12, fontcolor="#20242a", label="PWR_SW signal"];
  p_gnd_label [pos="565,335!", shape=plaintext, fontname="sans-serif", fontsize=11, fontcolor="#20242a", label="PWR_SW GND"];
  p_case_label [pos="555,413!", shape=plaintext, fontname="sans-serif", fontsize=11, fontcolor="#20242a", label="case power\nbutton"];
  p_q_label [pos="390,410!", shape=plaintext, fontname="sans-serif", fontsize=12, fontcolor="#20242a", label="Q1\n2N3904"];
  p_b_label [pos="283,439!", shape=plaintext, fontname="sans-serif", fontsize=10, fontcolor="#20242a", label="B"];
  p_c_label [pos="339,449!", shape=plaintext, fontname="sans-serif", fontsize=10, fontcolor="#20242a", label="C"];
  p_e_label [pos="339,376!", shape=plaintext, fontname="sans-serif", fontsize=10, fontcolor="#20242a", label="E"];
  p_common_label [pos="325,292!", shape=plaintext, fontname="sans-serif", fontsize=11, fontcolor="#20242a", label="PC + ESP GND"];

  // Reset button
  r_io [pos="95,150!", shape=circle, width=0.07, height=0.07];
  r_res [pos="170,150!", shape=box, width=0.75, height=0.3, fontname="sans-serif", fontsize=12, label="2.2 kΩ"];
  r_b [pos="240,150!", width=0.055, height=0.055];
  r_bar [pos="295,150!"];
  r_bar_top [pos="295,165!"];
  r_bar_bottom [pos="295,135!"];
  r_c_base [pos="295,161!"];
  r_e_base [pos="295,139!"];
  r_c [pos="325,180!"];
  r_e [pos="325,120!"];
  r_c_wire [pos="325,210!", width=0.055, height=0.055];
  r_signal [pos="500,210!", shape=circle, width=0.07, height=0.07];
  r_switch_top [pos="500,170!", shape=circle, width=0.07, height=0.07];
  r_switch_blade [pos="485,140!"];
  r_switch_bottom [pos="500,135!", shape=circle, width=0.07, height=0.07];
  r_header_gnd [pos="500,75!", shape=circle, width=0.07, height=0.07];
  r_gnd [pos="325,75!", width=0.055, height=0.055];
  r_pull_gnd [pos="240,75!"];
  r_pull [pos="240,105!", shape=box, width=0.62, height=0.32, fontname="sans-serif", fontsize=12, label="10 kΩ"];
  r_stem [pos="325,65!"];
  r_g1l [pos="311,65!"];
  r_g1r [pos="339,65!"];
  r_g2l [pos="316,59!"];
  r_g2r [pos="334,59!"];
  r_g3l [pos="321,53!"];
  r_g3r [pos="329,53!"];
  r_transistor [pos="310,150!", shape=circle, width=0.85, height=0.85, color="#20242a"];
  r_io -> r_res;
  r_res -> r_b;
  r_b -> r_bar;
  r_bar_top -> r_bar_bottom [penwidth=3];
  r_c_base -> r_c;
  r_c -> r_c_wire;
  r_c_wire -> r_signal;
  r_e -> r_gnd;
  r_b -> r_pull;
  r_pull -> r_pull_gnd;
  r_pull_gnd -> r_gnd;
  r_gnd -> r_header_gnd;
  r_signal -> r_switch_top;
  r_switch_top -> r_switch_blade;
  r_switch_bottom -> r_header_gnd;
  r_gnd -> r_stem;
  r_g1l -> r_g1r;
  r_g2l -> r_g2r;
  r_g3l -> r_g3r;
  r_e_base -> r_e [dir=forward, arrowhead=normal, arrowsize=0.65];
  r_io_label [pos="45,150!", shape=plaintext, fontname="sans-serif", fontsize=12, fontcolor="#20242a", label="ESP\nGPIO4"];
  r_signal_label [pos="445,233!", shape=plaintext, fontname="sans-serif", fontsize=12, fontcolor="#20242a", label="RESET_SW signal"];
  r_gnd_label [pos="565,75!", shape=plaintext, fontname="sans-serif", fontsize=11, fontcolor="#20242a", label="RESET_SW GND"];
  r_case_label [pos="555,153!", shape=plaintext, fontname="sans-serif", fontsize=11, fontcolor="#20242a", label="case reset\nbutton"];
  r_q_label [pos="390,150!", shape=plaintext, fontname="sans-serif", fontsize=12, fontcolor="#20242a", label="Q2\n2N3904"];
  r_b_label [pos="283,179!", shape=plaintext, fontname="sans-serif", fontsize=10, fontcolor="#20242a", label="B"];
  r_c_label [pos="339,189!", shape=plaintext, fontname="sans-serif", fontsize=10, fontcolor="#20242a", label="C"];
  r_e_label [pos="339,116!", shape=plaintext, fontname="sans-serif", fontsize=10, fontcolor="#20242a", label="E"];
  r_common_label [pos="325,32!", shape=plaintext, fontname="sans-serif", fontsize=11, fontcolor="#20242a", label="PC + ESP GND"];
  usb_note [pos="325,-2!", shape=plaintext, fontname="sans-serif", fontsize=11, fontcolor="#20242a", label="Disconnect +5VSB when using powered USB."];
}
